# FAROX front — copiar a .env y completar con las credenciales del proyecto Supabase.
# Las claves VITE_ son PÚBLICAS por diseño (viajan al navegador); cualquier otra clave
# del proyecto jamás debe aparecer en un prefijo VITE_ ni en el código del front.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# Numero de WhatsApp Business del asistente (solo digitos, con codigo de pais).
# Si se deja vacio, el boton de WhatsApp no aparece en el chat.
VITE_WHATSAPP_AGENT_NUMBER=
